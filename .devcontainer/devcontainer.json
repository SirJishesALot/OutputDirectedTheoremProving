{
    "name": "Theorem Proving User Study",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu", 
    "customizations": {
        "vscode": {
            "extensions": [
                "rocq-prover.vsrocq",
                "leanprover.lean4"
            ],
            "settings": {
                "vsrocq.path": "/home/vscode/.opam/rocq-9.0/bin/vsrocqtop"
            }
        }
    },
    "remoteEnv": {
        "PATH": "${containerEnv:HOME}/.elan/bin:${containerEnv:HOME}/.opam/rocq-9.0/bin:${containerEnv:PATH}",
        "COQ_LSP_PATH": "${containerEnv:HOME}/.opam/rocq-9.0/bin/coq-lsp"
    },
    "remoteUser": "vscode",
    "postCreateCommand": "bash .devcontainer/setup.sh"
}
