{
  "name": "outputdirectedtheoremproving",
  "displayName": "OutputDirectedTheoremProving",
  "description": "AI Agent that helps with output directed theorem proving in Coq. ",
  "version": "0.0.1",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "publisher": "SirJishesALot",
  "repository": {
    "type": "git",
    "url": "https://github.com/SirJishesALot/outputdirectedtheoremproving.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:outputdirectedtheoremproving.openProofState",
    "onCommand:outputdirectedtheoremproving.helloWorld",
    "onCommand:outputdirectedtheoremproving.setOpenAiApiKey",
    "onCommand:outputdirectedtheoremproving.setPortkeyApiKey",
    "onCommand:outputdirectedtheoremproving.switchLlmBackend",
    "onCommand:outputdirectedtheoremproving.getDefaultChatModel",
    "onCommand:outputdirectedtheoremproving.changeLLMModel",
    "onCommand:outputdirectedtheoremproving.toggleActiveProver",
    "onCommand:outputdirectedtheoremproving.updateProofState",
    "onCommand:outputdirectedtheoremproving.showProofStateLog",
    "onCommand:outputdirectedtheoremproving.copyDiagnosticReport",
    "onCommand:outputdirectedtheoremproving.acceptSuggestion",
    "onCommand:outputdirectedtheoremproving.rejectSuggestion",
    "onLanguage:coq",
    "onLanguage:rocq",
    "onLanguage:lean",
    "onLanguage:lean4"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "outputdirectedtheoremproving.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "outputdirectedtheoremproving.openProofState",
        "title": "Open Output Directed Proof State"
      },
      {
        "command": "outputdirectedtheoremproving.setOpenAiApiKey",
        "title": "Set OpenAI API Key"
      },
      {
        "command": "outputdirectedtheoremproving.getDefaultChatModel",
        "title": "Select LLM Service"
      },
      {
        "command": "outputdirectedtheoremproving.changeLLMModel",
        "title": "Change LLM Model"
      },
      {
        "command": "outputdirectedtheoremproving.updateProofState",
        "title": "Update Proof State at Cursor"
      },
      {
        "command": "outputdirectedtheoremproving.showProofStateLog",
        "title": "Show Proof State Log"
      },
      {
        "command": "outputdirectedtheoremproving.copyDiagnosticReport",
        "title": "Copy Diagnostic Report"
      },
      {
        "command": "outputdirectedtheoremproving.acceptSuggestion",
        "title": "Accept Proof Suggestion"
      },
      {
        "command": "outputdirectedtheoremproving.rejectSuggestion",
        "title": "Reject Proof Suggestion"
      },
      {
        "command": "outputdirectedtheoremproving.toggleActiveProver",
        "title": "Toggle Active Prover (Coq/Lean)"
      },
      {
        "command": "outputdirectedtheoremproving.setPortkeyApiKey",
        "title": "Set Portkey API Key"
      },
      {
        "command": "outputdirectedtheoremproving.switchLlmBackend",
        "title": "Switch LLM Backend (Antigravity CLI / Portkey)"
      }
    ],
    "configuration": {
      "title": "Output Directed Theorem Proving",
      "properties": {
        "myExtension.llmBackend": {
          "type": "string",
          "enum": [
            "antigravity-cli",
            "portkey",
            "openai",
            "vertex"
          ],
          "default": "antigravity-cli",
          "description": "Select the primary LLM backend for proof assistance and suggestions (Antigravity CLI or Portkey)."
        },
        "myExtension.antigravityCliPath": {
          "type": "string",
          "default": "agy",
          "description": "Path to the Antigravity CLI executable (agy)."
        },
        "myExtension.defaultAntigravityModel": {
          "type": "string",
          "default": "gemini-3.8-flash-low",
          "description": "Default model used by Antigravity CLI (e.g. gemini-3.8-flash-low, gemini-3.8-flash-high, gemini-3.1-pro-high, claude-sonnet-5-5-high)."
        },
        "myExtension.activeProver": {
          "type": "string",
          "enum": [
            "Coq",
            "Lean"
          ],
          "default": "Coq",
          "description": "Select the active prover backend used by the extension."
        },
        "myExtension.autoSwitchProver": {
          "type": "boolean",
          "default": true,
          "description": "Automatically switch active prover based on focused editor language (Coq or Lean)."
        },
        "myExtension.defaultPortkeyModel": {
          "type": "string",
          "default": "@GCP-public-dataset-integration/gemini-3.1-pro-preview",
          "description": "Default Portkey model slug used for AI assistant and theorem proving agent."
        },
        "myExtension.portkeyProviderSlug": {
          "type": "string",
          "default": "@GCP-public-dataset-integration",
          "description": "Default provider slug in Portkey."
        },
        "myExtension.portkeyBaseUrl": {
          "type": "string",
          "default": "https://api.portkey.ai/v1",
          "description": "Base URL for the Portkey AI Gateway."
        },
        "myExtension.defaultGeminiModel": {
          "type": "string",
          "default": "gemini-3.1-pro-preview",
          "description": "Gemini model id used by default when Gemini (Vertex AI) is selected (e.g. gemini-3.1-pro-preview)."
        },
        "myExtension.coqGoalsTimeoutMs": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "Max milliseconds to wait for a coq-lsp proof/goals response before showing a timeout error in the proof state panel."
        }
      }
    },
    "keybindings": [
      {
        "command": "outputdirectedtheoremproving.updateProofState",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (editorLangId == 'coq' || editorLangId == 'rocq' || editorLangId == 'lean4' || editorLangId == 'lean')"
      },
      {
        "command": "outputdirectedtheoremproving.updateProofState",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus && (editorLangId == 'coq' || editorLangId == 'rocq' || editorLangId == 'lean4' || editorLangId == 'lean')"
      },
      {
        "command": "outputdirectedtheoremproving.acceptSuggestion",
        "key": "ctrl+shift+y",
        "mac": "cmd+shift+y",
        "when": "coqExtension.suggestionActive && editorTextFocus"
      },
      {
        "command": "outputdirectedtheoremproving.rejectSuggestion",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "coqExtension.suggestionActive && editorTextFocus"
      }
    ],
    "chatParticipants": [
      {
        "id": "coq.llmChat",
        "fullName": "Coq Prover AI",
        "name": "coqproverai",
        "when": "resourceExtname == .v",
        "isSticky": true,
        "description": "What can I help you with regarding Coq?"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js && npm run compile-webview",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "npm run watch-webview",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && npm run compile-webview:production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "comment-new-scripts": "--- These are the new scripts for the webview ---",
    "compile-webview": "npm run compile-webview:main && npm run compile-webview-chat",
    "compile-webview:main": "esbuild ./src/webview/main.js --bundle --outfile=src/webview/proofState.js --platform=browser --external:vscode",
    "compile-webview-chat": "esbuild ./src/webview/chatPanel.js --bundle --outfile=src/webview/proofStateChat.js --platform=browser --external:vscode",
    "watch-webview": "esbuild ./src/webview/main.js --bundle --outfile=src/webview/proofState.js --platform=browser --external:vscode --watch",
    "compile-webview:production": "esbuild ./src/webview/main.js --bundle --outfile=src/webview/proofState.js --platform=browser --external:vscode --minify"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/tmp": "^0.2.6",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.34.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@handlewithcare/prosemirror-suggest-changes": "^0.1.7",
    "ajv": "^8.17.1",
    "async-mutex": "^0.5.0",
    "axios": "^1.12.2",
    "dotenv": "^17.4.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.11",
    "marked": "^17.0.1",
    "openai": "^6.3.0",
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.10.4",
    "prosemirror-view": "^1.41.3",
    "tiktoken": "^1.0.22",
    "tmp": "^0.2.5",
    "ts-results": "npm:ts-results-es@^3.6.0",
    "tslib": "^2.8.1",
    "vscode-languageclient": "^9.0.1"
  }
}
